nsson.koinomvp.dev" content-desc="Psaltaren 55:8" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[71,337][1022,365]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,337][1020,342]" drawing-order="1" hint=""><node index="0" text="8 " resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,337][137,214]" drawing-order="1" hint="" /><node index="1" text="Se, då skulle jag fly långt bort och slå mig ner i öknen. Sela." resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,337][1020,342]" drawing-order="2" hint="" /></node></node></node><node index="10" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[58,384][1022,740]" drawing-order="11" hint=""><node index="0" text="" resource-id="" class="android.widget.Button" package="com.akhansson.koinomvp.dev" content-desc="Psaltaren 55:9" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[71,384][1022,740]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,408][1020,717]" drawing-order="1" hint=""><node index="0" text="9 " resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,408][137,486]" drawing-order="1" hint="" /><node index="1" text="Jag skulle skynda mig att söka skydd mot vinande vind och storm." resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,408][1020,717]" drawing-order="2" hint="" /></node></node></node><node index="11" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[58,759][1022,1115]" drawing-order="12" hint=""><node index="0" text="" resource-id="" class="android.widget.Button" package="com.akhansson.koinomvp.dev" content-desc="Psaltaren 55:10" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[71,759][1