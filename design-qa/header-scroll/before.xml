ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,1157][1020,1466]" drawing-order="1" hint=""><node index="0" text="11 " resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,1157][162,1235]" drawing-order="1" hint="" /><node index="1" text="Dag och natt går de runt den uppe på murarna, ondska och olycka råder därinne." resource-id="" class="android.widget.TextView" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[162,1157][1020,1466]" drawing-order="2" hint="" /></node></node></node><node index="13" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[58,1508][1022,1865]" drawing-order="14" hint=""><node index="0" text="" resource-id="" class="android.widget.Button" package="com.akhansson.koinomvp.dev" content-desc="Psaltaren 55:12" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[71,1508][1022,1865]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.akhansson.koinomvp.dev" content-desc="" checkable="false" checked="false