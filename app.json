{
  "expo": {
    "name": "KOINO",
    "slug": "koino-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "koino",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7EFE4"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./koino-logo.png",
      "name": "KOINO",
      "shortName": "KOINO",
      "description": "Community faith app",
      "backgroundColor": "#F7EFE4",
      "themeColor": "#F7EFE4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7EFE4"
      },
      "package": "com.akhansson.koinomvp"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KOINO to choose a community image from your photo library."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
