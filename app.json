{
  "expo": {
    "name": "KOINO",
    "slug": "koino-mvp",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "koino",
    "icon": "./koino-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7EFE4"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./koino-logo.png",
        "backgroundColor": "#F7EFE4"
      },
      "package": "com.akhansson.koinomvp",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KOINO to choose a community image from your photo library."
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "587506fb-be73-46b3-a680-0207aadeb2cf"
      }
    }
  }
}
