    "validate:join-qr": "node scripts/validate-join-qr.mjs",
    "validate:join-qr-emulator": "npm --prefix functions run build && npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-join-qr-emulator.mjs\"",
    "validate:fasting": "node scripts/validate-fasting-time.mjs",
    "validate:audio": "node scripts/validate-audio.mjs",
    "validate:reading": "node scripts/validate-reading.mjs",
    "validate:reading-mirror": "node scripts/validate-reading-mirror.mjs",
    "validate:reading-mirror-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-events.json --only auth,database --project demo-koino \"node scripts/validate-reading-mirror-emulator.mjs\"",
    "validate:reading-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-events.json --only auth,database --project demo-koino \"node scripts/validate-reading-emulator.mjs\"",
    "validate:events-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-events.json --only auth,database --project demo-koino \"node scripts/validate-events-emulator.mjs\"",
    "validate:bible-search": "node scripts/validate-bible-search.mjs",
    "validate:bible-async": "node scripts/validate-bible-async.mjs",
    "validate:bible-verse-selection": "node scripts/validate-bible-verse-selection.mjs",
    "validate:bible-copy": "node scripts/validate-bible-copy.mjs",
    "validate:saved-verses": "node scripts/validate-saved-verses.mjs",
    "validate:bible-highlights": "node scripts/validate-bible-highlights.mjs",
    "validate:bible-picker": "node scripts/validate-bible-picker-lifecycle.mjs",
    "validate:bible-history": "node scripts/validate-bible-history.mjs",
    "validate:bible-chapter-navigation": "node scripts/validate-bible-chapter-navigation.mjs",
    "validate:bible-header": "node scripts/validate-bible-header.mjs",
    "validate:bible-reading-layout": "node scripts/validate-bible-reading-layout.mjs",
    "validate:startup": "node scripts/validate-startup-dependencies.mjs",
    "validate:bible-startup": "node scripts/validate-bible-startup.mjs",
    "validate:startup-memberships": "node scripts/validate-startup-memberships.mjs",
    "validate:pagination": "node scripts/validate-firebase-pagination.mjs",
