{
  "name": "koino-mvp",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel --clear",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "video:studio": "remotion studio remotion/src/index.ts",
    "video:render": "remotion render remotion/src/index.ts KoinoLaunchTeaser out/koino-launch-teaser.mp4",
    "video:still": "remotion still remotion/src/index.ts KoinoLaunchTeaser --frame=90 --scale=0.25 out/koino-launch-teaser-frame.png"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/three": "^0.184.1",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-gl": "~16.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.12.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@remotion/cli": "^4.0.464",
    "@types/react": "~19.1.10",
    "remotion": "^4.0.464",
    "typescript": "~5.9.2"
  }
}
