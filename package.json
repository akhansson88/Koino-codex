{
  "name": "koino-mvp",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "main": "index.js",
  "scripts": {
    "validate:bible-audio": "node scripts/validate-bible-audio.mjs",
    "validate:bible-audio-restore": "node scripts/validate-bible-audio-restore.mjs",
    "validate:bible-audio-follow": "node scripts/validate-bible-audio-follow.mjs",
    "validate:saved-verse-audio": "node scripts/validate-saved-verse-audio.mjs",
    "validate:bible-drawer": "node scripts/validate-bible-drawer.mjs",
    "validate:topic-audio": "node scripts/validate-topic-audio.mjs",
    "validate:topic-controls": "node scripts/validate-topic-controls.mjs",
    "bible:audio": "python scripts/bible-audio/audio.py",
    "start": "cross-env APP_VARIANT=development EXPO_NO_DOTENV=1 expo start --dev-client",
    "start:production": "cross-env APP_VARIANT=production EXPO_NO_DOTENV=1 expo start",
    "start:lan": "cross-env APP_VARIANT=development EXPO_NO_DOTENV=1 expo start --dev-client --lan",
    "start:tunnel": "cross-env APP_VARIANT=development EXPO_NO_DOTENV=1 expo start --dev-client --tunnel",
    "start:clear": "cross-env APP_VARIANT=development EXPO_NO_DOTENV=1 expo start --dev-client --clear",
    "android": "expo run:android",
    "android:dev": "node scripts/native/run-development-android.cjs",
    "start:dev": "node scripts/native/run-development-android.cjs --metro-only",
    "android:tailscale": "node scripts/native/tailscale-android.cjs connect",
    "start:tailscale": "node scripts/native/tailscale-android.cjs start",
    "android:tailscale:logs": "node scripts/native/tailscale-android.cjs logs",
    "android:logs": "adb logcat *:S ReactNative:V ReactNativeJS:V AndroidRuntime:E Expo:V",
    "ios": "expo run:ios",
    "ios:dev": "node scripts/native/run-development-ios.cjs",
    "ios:dev:verify": "node scripts/native/verify-development-ios.cjs",
    "bible:build": "node scripts/generate-bible-data.mjs",
    "doctor": "npx expo-doctor",
    "validate:bible-plans": "node scripts/validate-bible-plan-schedule.mjs && node scripts/validate-bible-plan-progress.mjs && node scripts/validate-bible-plan-library.mjs && node scripts/validate-me-bible-plans.mjs",
