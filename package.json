    "test:donations": "node --test scripts/donation-api.test.cjs",
    "typecheck": "tsc --noEmit",
    "validate:signup-rules": "node scripts/validate-signup-rules.mjs",
    "typecheck:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "validate:interactions": "node scripts/validate-native-interactions.mjs",
    "validate:selective-state": "node scripts/validate-selective-state.mjs",
    "validate:email-verification": "node scripts/validate-email-verification.mjs",
    "validate:notification-navigation": "node scripts/validate-notification-navigation.mjs",
    "validate:prayers": "node scripts/validate-prayer-notifications.mjs",
    "validate:legacy-records": "node scripts/validate-legacy-records.mjs",
    "validate:community-navigation": "node scripts/validate-community-navigation.mjs",
    "validate:presence": "node scripts/validate-presence.mjs",
    "validate:presence-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-presence-emulator.mjs\"",
    "postinstall": "node scripts/patch-track-player.cjs && node scripts/patch-libsodium.cjs && node scripts/patch-onnx-runtime.cjs",
    "bible:search:build": "node scripts/hybrid-search/run.mjs",
    "bible:search:prototypes": "node scripts/hybrid-search/build-query-prototypes.mjs",
    "bible:search:suggestions": "node scripts/hybrid-search/build-topic-suggestions.mjs",
    "bible:study:fetch": "node scripts/study-pack/fetch-sources.mjs && node scripts/study-pack/fetch-commentary.mjs",
    "bible:study:commentary": "node scripts/study-pack/fetch-commentary.mjs",
    "bible:study:build": "node scripts/study-pack/build.mjs",
    "validate:hybrid-search": "node scripts/validate-hybrid-search.mjs",
    "test:bible-search-pagination": "node --test scripts/search-pagination.test.mjs",
    "test:bible-model": "node --test scripts/finetune-model.test.mjs",
    "validate:bible-search-ui": "node scripts/validate-bible-search-ui.mjs",
    "validate:encryption": "node scripts/validate-encryption.mjs",
    "encryption:rules": "node scripts/generate-encryption-rules.mjs",
    "validate:encryption-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-encryption-emulator.mjs\"",
    "validate:community-moderation": "node scripts/validate-community-moderation.mjs && node scripts/validate-community-moderation-ui.mjs",
    "validate:community-leaders": "npm --prefix functions run build && npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-community-leaders-emulator.mjs\"",
    "validate:community-moderation-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-community-moderation-emulator.mjs\"",
    "validate:encryption-backend": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-encryption-backend.mjs\"",
    "validate:encryption-adapter": "node scripts/validate-encryption-adapter.mjs",
    "validate:encryption-migration": "node scripts/validate-encryption-migration.mjs",
    "encryption:recovery-seed": "node scripts/generate-recovery-seed.mjs",
    "validate:development-client": "node scripts/validate-development-client.mjs",
    "validate:account-deletion": "node scripts/validate-account-deletion-manifest.mjs",
    "validate:account-deletion-emulator": "npx firebase-tools emulators:exec --config firebase.account-deletion-test.json --only auth,database --project demo-koino \"node scripts/validate-account-deletion-emulator.mjs\""
