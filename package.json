{
  "name": "koino-mvp",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "validate:bible-audio": "node scripts/validate-bible-audio.mjs",
    "validate:bible-audio-restore": "node scripts/validate-bible-audio-restore.mjs",
    "validate:bible-audio-follow": "node scripts/validate-bible-audio-follow.mjs",
    "validate:saved-verse-audio": "node scripts/validate-saved-verse-audio.mjs",
    "validate:bible-drawer": "node scripts/validate-bible-drawer.mjs",
    "validate:topic-audio": "node scripts/validate-topic-audio.mjs",
    "validate:topic-controls": "node scripts/validate-topic-controls.mjs",
    "bible:audio": "python scripts/bible-audio/audio.py",
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:dev": "node scripts/native/run-development-android.cjs",
    "start:dev": "adb reverse tcp:8081 tcp:8081 && cross-env APP_VARIANT=development expo start --dev-client --localhost",
    "android:tailscale": "node scripts/native/tailscale-android.cjs connect",
    "start:tailscale": "node scripts/native/tailscale-android.cjs start",
    "android:tailscale:logs": "node scripts/native/tailscale-android.cjs logs",
    "android:logs": "adb logcat *:S ReactNative:V ReactNativeJS:V AndroidRuntime:E Expo:V",
    "ios": "expo run:ios",
    "bible:build": "node scripts/generate-bible-data.mjs",
    "doctor": "npx expo-doctor",
    "validate:bible-plans": "node scripts/validate-bible-plan-schedule.mjs",
    "validate:bible-search": "node scripts/validate-bible-search.mjs",
    "validate:bible-async": "node scripts/validate-bible-async.mjs",
    "validate:bible-verse-selection": "node scripts/validate-bible-verse-selection.mjs",
    "validate:bible-highlights": "node scripts/validate-bible-highlights.mjs",
    "validate:bible-picker": "node scripts/validate-bible-picker-lifecycle.mjs",
    "validate:bible-history": "node scripts/validate-bible-history.mjs",
    "validate:startup": "node scripts/validate-startup-dependencies.mjs",
    "validate:bible-startup": "node scripts/validate-bible-startup.mjs",
    "validate:startup-memberships": "node scripts/validate-startup-memberships.mjs",
    "validate:pagination": "node scripts/validate-firebase-pagination.mjs",
    "validate:database-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-database-emulator.mjs\"",
    "test:donations": "node --test scripts/donation-api.test.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "validate:interactions": "node scripts/validate-native-interactions.mjs",
    "validate:selective-state": "node scripts/validate-selective-state.mjs",
    "validate:notification-navigation": "node scripts/validate-notification-navigation.mjs",
    "validate:community-navigation": "node scripts/validate-community-navigation.mjs",
    "postinstall": "node scripts/patch-track-player.cjs && node scripts/patch-libsodium.cjs && node scripts/patch-onnx-runtime.cjs",
    "bible:search:build": "node scripts/hybrid-search/run.mjs",
    "validate:hybrid-search": "node scripts/validate-hybrid-search.mjs",
    "validate:bible-search-ui": "node scripts/validate-bible-search-ui.mjs",
    "validate:encryption": "node scripts/validate-encryption.mjs",
    "encryption:rules": "node scripts/generate-encryption-rules.mjs",
    "validate:encryption-emulator": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-encryption-emulator.mjs\"",
    "validate:encryption-backend": "npx firebase-tools emulators:exec --config firebase.emulator-test.json --only auth,database --project demo-koino \"node scripts/validate-encryption-backend.mjs\"",
    "validate:encryption-adapter": "node scripts/validate-encryption-adapter.mjs",
    "validate:encryption-migration": "node scripts/validate-encryption-migration.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@huggingface/tokenizers": "0.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.12.1",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "^4.1.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "onnxruntime-node": "1.24.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
