    "validate:bible-plans": "node scripts/validate-bible-plan-schedule.mjs",
    "validate:bible-search": "node scripts/validate-bible-search.mjs",
    "validate:startup": "node scripts/validate-startup-dependencies.mjs",
    "validate:pagination": "node scripts/validate-firebase-pagination.mjs",
    "test:donations": "node --test scripts/donation-api.test.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-gl": "~16.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.12.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
