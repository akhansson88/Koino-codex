{
  "name": "koino-mvp",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "dev": "node scripts/expo-preview.mjs",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel --clear",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "bash scripts/build-verified.sh",
    "build:web": "expo export --platform web && node scripts/inject-pwa.js",
    "build:pwa": "npm run build:web",
    "deploy:preview": "npm run build:web && netlify deploy --dir dist --functions netlify/functions",
    "deploy:netlify": "npm run build:web && netlify deploy --prod --dir dist --functions netlify/functions",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "typecheck": "tsc --noEmit",
    "video:studio": "remotion studio remotion/src/index.ts",
    "video:render": "remotion render remotion/src/index.ts KoinoLaunchTeaser out/koino-launch-teaser.mp4",
    "video:still": "remotion still remotion/src/index.ts KoinoLaunchTeaser --frame=90 --scale=0.25 out/koino-launch-teaser-frame.png"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/three": "^0.184.1",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-gl": "~16.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.12.1",
    "pako": "^3.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@remotion/cli": "^4.0.464",
    "@types/react": "~19.1.10",
    "remotion": "^4.0.464",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
