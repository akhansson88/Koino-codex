{
  "rules": {
    ".read": false,
    ".write": false,

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.val() == null || (newData.child('id').val() == $uid && newData.child('name').isString())"
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.val() == null && root.child('groups').child(data.child('groupId').val()).child('ownerId').val() == auth.uid) || (!data.exists() && newData.val() != null && root.child('groups').child(newData.child('groupId').val()).child('ownerId').val() == auth.uid))",
        ".validate": "newData.val() == null || newData.child('groupId').isString()"
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() == auth.uid) || (data.exists() && data.child('ownerId').val() == auth.uid))",
        ".validate": "newData.val() == null || (newData.child('id').val() == $groupId && newData.child('name').isString() && newData.child('inviteCode').isString() && newData.child('ownerId').isString())"
      }
    },

    "groupMembers": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && newData.val() == null && root.child('groups').child($groupId).child('ownerId').val() == auth.uid",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('groups').child($groupId).child('ownerId').val() == auth.uid)",
          ".validate": "newData.val() == null || (newData.child('userId').val() == $uid && newData.child('groupId').val() == $groupId && newData.child('userName').isString())"
        }
      }
    },

    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$groupId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('groups').child($groupId).child('ownerId').val() == auth.uid)",
          ".validate": "newData.val() == null || (newData.child('userId').val() == $uid && newData.child('groupId').val() == $groupId && newData.child('userName').isString())"
        }
      }
    },

    "checkIns": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && newData.val() == null && root.child('groups').child($groupId).child('ownerId').val() == auth.uid",
        "$checkInId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists() && (newData.val() == null || newData.child('userId').val() == auth.uid)",
          ".validate": "newData.val() == null || (newData.child('id').val() == $checkInId && newData.child('groupId').val() == $groupId && newData.child('visibility').val() == 'group')"
        }
      }
    },

    "privateCheckIns": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$checkInId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.child('id').val() == $checkInId && newData.child('userId').val() == $uid && newData.child('visibility').val() == 'private')"
        }
      }
    },

    "posts": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && newData.val() == null && root.child('groups').child($groupId).child('ownerId').val() == auth.uid",
        "$postId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists() && (newData.val() == null || newData.child('userId').val() == auth.uid)",
          ".validate": "newData.val() == null || (newData.child('id').val() == $postId && newData.child('groupId').val() == $groupId && newData.child('body').isString())"
        }
      }
    },

    "replies": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && newData.val() == null && root.child('groups').child($groupId).child('ownerId').val() == auth.uid",
        "$replyId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists() && (newData.val() == null || newData.child('userId').val() == auth.uid)",
          ".validate": "newData.val() == null || (newData.child('id').val() == $replyId && newData.child('body').isString())"
        }
      }
    },

    "prayerReactions": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists()",
        ".write": "auth != null && newData.val() == null && root.child('groups').child($groupId).child('ownerId').val() == auth.uid",
        "$reactionId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).exists() && (newData.val() == null || newData.child('userId').val() == auth.uid)",
          ".validate": "newData.val() == null || newData.child('userId').val() == auth.uid"
        }
      }
    },

    "prayerSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$sessionId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.child('id').val() == $sessionId && newData.child('userId').val() == $uid)"
        }
      }
    },

    "journalEntries": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$entryId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.child('id').val() == $entryId && newData.child('userId').val() == $uid && newData.child('body').isString())"
        }
      }
    },

    "supportIntents": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$intentId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.child('id').val() == $intentId && newData.child('userId').val() == $uid)"
        }
      }
    }
  }
}
