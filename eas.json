{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "autoIncrement": true,
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "store-internal": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "emulator-ios": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "channel": "emulator",
      "env": {
        "APP_VARIANT": "emulator",
        "EXPO_PUBLIC_KOINO_EMULATOR_HOST": "100.100.67.44"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "emulator-android": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "channel": "emulator",
      "env": {
        "APP_VARIANT": "emulator",
        "EXPO_PUBLIC_KOINO_EMULATOR_HOST": "100.100.67.44"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": ".eas-submit/google-play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6809953941"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
